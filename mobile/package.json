    "@capacitor/network": "^8.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "maplibre-gl": "^5.24.0",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^7.3.7"
  }
}
